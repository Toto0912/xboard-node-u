+func TestSessionCloseXUDPWithTimeoutWrapperReader(t *testing.T) {
+	r, _ := pipe.New(pipe.WithoutSizeLimit())
+	wrapped := &buf.TimeoutWrapperReader{Reader: r}
+	m := NewSessionManager()
+	s := &Session{ID: 1, parent: m, input: wrapped, XUDP: &XUDP{Status: Active}}
