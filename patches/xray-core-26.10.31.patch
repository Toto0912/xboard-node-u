@@ -0,0 +1,48 @@
+package dispatcher
+
+import (
+	"context"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/features/bandwidth"
+	"golang.org/x/time/rate"
+)
+
+type RateLimitWriter struct {
+	Writer  buf.Writer
+	Limiter *rate.Limiter
+	Context context.Context
+	Manager bandwidth.Manager
+	User    string
+}
+
+func (w *RateLimitWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	limiter := w.Limiter
+	if w.Manager != nil {
+		limiter = w.Manager.GetUserLimiter(w.User)
+	}
+	if limiter != nil {
+		ctx := w.Context
+		if ctx == nil {
+			ctx = context.Background()
+		}
+		remaining := int(mb.Len())
+		for remaining > 0 {
+			n := min(remaining, limiter.Burst())
+			if n <= 0 {
+				buf.ReleaseMulti(mb)
+				return context.Canceled
+			}
+			if err := limiter.WaitN(ctx, n); err != nil {
+				buf.ReleaseMulti(mb)
+				return err
+			}
+			remaining -= n
+		}
+	}
+	return w.Writer.WriteMultiBuffer(mb)
+}
+
+func (w *RateLimitWriter) Close() error { return common.Close(w.Writer) }
+func (w *RateLimitWriter) Interrupt()   { common.Interrupt(w.Writer) }
