index 0000000..c74a682
--- /dev/null
+++ b/app/dispatcher/ratelimit.go
@@ -0,0 +1,72 @@
+package dispatcher
+
+import (
+	"context"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/features/bandwidth"
+	"golang.org/x/time/rate"
+)
+
+type RateLimitWriter struct {
+	Writer  buf.Writer
+	Limiter *rate.Limiter
+	Context context.Context
+	Manager bandwidth.Manager
+	User    string
+}
+
+type rateLimitReader struct {
+	reader  buf.Reader
+	ctx     context.Context
+	manager bandwidth.Manager
+	user    string
+}
+
+func (r *rateLimitReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	mb, err := r.reader.ReadMultiBuffer()
+	if len(mb) != 0 {
+		if limitErr := limitBuffer(r.ctx, r.manager.GetUserLimiter(r.user), mb); limitErr != nil {
+			return nil, limitErr
+		}
+	}
+	return mb, err
+}
+
+func (w *RateLimitWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	limiter := w.Limiter
+	if w.Manager != nil {
+		limiter = w.Manager.GetUserLimiter(w.User)
+	}
+	if err := limitBuffer(w.Context, limiter, mb); err != nil {
+		return err
+	}
+	return w.Writer.WriteMultiBuffer(mb)
+}
+
+// limitBuffer releases mb on failure. On success ownership stays with the caller.
+func limitBuffer(ctx context.Context, limiter *rate.Limiter, mb buf.MultiBuffer) error {
+	if limiter == nil {
+		return nil
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	for remaining := int(mb.Len()); remaining > 0; {
+		n := min(remaining, limiter.Burst())
+		if n <= 0 {
+			buf.ReleaseMulti(mb)
+			return context.Canceled
+		}
+		if err := limiter.WaitN(ctx, n); err != nil {
+			buf.ReleaseMulti(mb)
+			return err
+		}
+		remaining -= n
+	}
+	return nil
+}
+
+func (w *RateLimitWriter) Close() error { return common.Close(w.Writer) }
+func (w *RateLimitWriter) Interrupt()   { common.Interrupt(w.Writer) }
