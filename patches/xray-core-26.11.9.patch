 }
 
 // CreateObject creates an object by its config. The config type must be registered through RegisterConfig().
+// ReplaceConfigCreator decorates a factory during package initialization only.
+func ReplaceConfigCreator(config interface{}, creator ConfigCreator) (ConfigCreator, error) {
+	key := reflect.TypeOf(config)
+	previous, found := typeCreatorRegistry[key]
+	if !found || creator == nil {
+		return nil, errors.New("cannot replace config creator")
+	}
+	typeCreatorRegistry[key] = creator
+	return previous, nil
