+package internet_test
+
+import (
+	"context"
+	"testing"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/features/dns"
+	"github.com/xtls/xray-core/features/outbound"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+type handoffDNS struct {
+	dns.Client
+	ip net.IP
+}
+
+func (d handoffDNS) LookupIP(string, dns.IPOption) ([]net.IP, uint32, error) {
+	return []net.IP{d.ip}, 60, nil
+}
+
+type handoffOutbounds struct {
+	outbound.Manager
+	calls int
+}
+
+func (m *handoffOutbounds) GetHandler(string) outbound.Handler {
+	m.calls++
+	return nil
+}
+
+func TestClosedDialerFeaturesDoNotBorrowCurrentInstance(t *testing.T) {
+	ipA, ipB := net.ParseIP("127.0.0.1"), net.ParseIP("127.0.0.2")
+	old := internet.NewDialerFeatures(handoffDNS{ip: ipA}, nil)
+	old.SetDefault()
+	currentOutbounds := new(handoffOutbounds)
+	current := internet.NewDialerFeatures(handoffDNS{ip: ipB}, currentOutbounds)
+	defer current.Close()
+	current.SetDefault()
+	stale := &internet.MemoryStreamConfig{SocketSettings: &internet.SocketConfig{DialerProxy: "shared-tag"}}
+	stale.BindDialerFeatures(old)
+	old.Close()
+	if _, err := old.LookupForIP("fixture.invalid", internet.DomainStrategy_FORCE_IP4, nil); err == nil {
+		t.Fatal("closed DNS owner still usable")
+	}
+	if _, err := internet.DialSystem(context.Background(), net.TCPDestination(net.LocalHostIP, 80), stale.SocketSettings); err == nil || currentOutbounds.calls != 0 {
+		t.Fatal("stale socket selected the current instance's outbound")
+	}
+	ips, err := internet.LookupForIP("fixture.invalid", internet.DomainStrategy_FORCE_IP4, nil)
+	if err != nil || len(ips) != 1 || !ips[0].Equal(ipB) {
+		t.Fatalf("closing the old instance changed the current default: %v, %v", ips, err)
+	}
+	current.Close()
+	if _, err := internet.LookupForIP("fixture.invalid", internet.DomainStrategy_FORCE_IP4, nil); err == nil {
+		t.Fatal("closing the last instance retained its DNS client")
+	}
+}
