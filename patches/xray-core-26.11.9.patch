--- /dev/null
+++ b/app/dispatcher/ratelimit_test.go
@@ -0,0 +1,155 @@
+package dispatcher
+
+import (
+	"context"
+	"errors"
+	"io"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+	bandwidthfeat "github.com/xtls/xray-core/features/bandwidth"
+	featurepolicy "github.com/xtls/xray-core/features/policy"
+	featurestats "github.com/xtls/xray-core/features/stats"
+	"github.com/xtls/xray-core/transport"
+	"golang.org/x/time/rate"
+)
+
+type stubWriter struct{ calls int }
+
+func TestRateLimitLargeBatchAndLiveUpdate(t *testing.T) {
+	bm := bandwidthfeat.New()
+	dest := &stubWriter{}
+	ctx, cancel := context.WithCancel(context.Background())
+	w := applyBandwidthLimit(ctx, dest, bm, &protocol.MemoryUser{Email: "live"})
+	buffer := func() buf.MultiBuffer { b := buf.New(); b.Extend(16); return buf.MultiBuffer{b} }
+	if err := w.WriteMultiBuffer(buffer()); err != nil {
+		t.Fatal(err)
+	}
+	bm.SetUserLimiter("live", rate.NewLimiter(100000, 4))
+	if err := w.WriteMultiBuffer(buffer()); err != nil {
+		t.Fatalf("batch exceeding burst: %v", err)
+	}
+	if dest.calls != 2 {
+		t.Fatal("writer not reached")
+	}
+	cancel()
+	bm.SetUserLimiter("live", rate.NewLimiter(1, 1))
+	if err := w.WriteMultiBuffer(buffer()); err == nil {
+		t.Fatal("existing writer ignored new limit")
+	}
+	bm.Reset()
+	if err := w.WriteMultiBuffer(buffer()); err != nil {
+		t.Fatal("removed limit remained active", err)
+	}
+
+}
+func (w *stubWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	w.calls++
+	buf.ReleaseMulti(mb)
+	return nil
+}
+func (w *stubWriter) Close() error { return nil }
+func (w *stubWriter) Interrupt()   {}
+
+type testReadFunc func() (buf.MultiBuffer, error)
+
+func (f testReadFunc) ReadMultiBuffer() (buf.MultiBuffer, error) { return f() }
+
+func testPayload(n int32) buf.MultiBuffer {
+	b := buf.New()
+	b.Extend(n)
+	return buf.MultiBuffer{b}
+}
+
+func TestWrapLinkMetersSharedBucketOnceAfterTimeout(t *testing.T) {
+	inst := new(core.Instance)
+	bm := bandwidthfeat.New()
+	if err := inst.AddFeature(bm); err != nil {
+		t.Fatalf("AddFeature(bandwidth) error = %v", err)
+	}
+	ctx := context.WithValue(context.Background(), core.XrayKey(1), inst)
+	ctx = session.ContextWithInbound(ctx, &session.Inbound{User: &protocol.MemoryUser{Email: "user@example.com"}, Source: net.TCPDestination(net.IPAddress([]byte{127, 0, 0, 1}), 1234)})
+	ctx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	defer cancel()
+	ready := make(chan struct{})
+	var last buf.MultiBuffer
+	source := testReadFunc(func() (buf.MultiBuffer, error) {
+		<-ready
+		last = testPayload(7)
+		return last, io.EOF
+	})
+	link := WrapLink(ctx, featurepolicy.DefaultManager{}, featurestats.NoopManager{}, &transport.Link{Reader: source, Writer: &stubWriter{}})
+	timeoutReader := link.Reader.(*buf.TimeoutWrapperReader)
+	// A session opened without a limit must observe later changes.
+	bucket := rate.NewLimiter(0, 16)
+	bm.SetUserLimiter("user@example.com", bucket)
+	if mb, err := timeoutReader.ReadMultiBufferTimeout(time.Millisecond); mb != nil || err != buf.ErrReadTimeout {
+		t.Fatalf("expected read timeout, got %v, %v", mb, err)
+	}
+	close(ready)
+	mb, err := timeoutReader.ReadMultiBuffer()
+	if mb.Len() != 7 || err != io.EOF || bucket.Tokens() != 9 {
+		t.Fatalf("deferred read: bytes=%d err=%v tokens=%v", mb.Len(), err, bucket.Tokens())
+	}
+	buf.ReleaseMulti(mb)
+	if err := link.Writer.WriteMultiBuffer(testPayload(9)); err != nil || bucket.Tokens() != 0 {
+		t.Fatalf("shared downlink: err=%v tokens=%v", err, bucket.Tokens())
+	}
+	cancel()
+	if mb, err := timeoutReader.ReadMultiBuffer(); !errors.Is(err, context.Canceled) || mb != nil || last[0] != nil {
+		t.Fatal("canceled rate wait should release the entire unread batch")
+	}
+	bm.Reset()
+	mb, err = timeoutReader.ReadMultiBuffer()
+	if mb.Len() != 7 || err != io.EOF {
+		t.Fatalf("removed limit remained active on reader: bytes=%d err=%v", mb.Len(), err)
+	}
+	buf.ReleaseMulti(mb)
+}
+
+func TestGetLinkChargesOnlyTheTwoPipeWriters(t *testing.T) {
+	bm := bandwidthfeat.New()
+	bucket := rate.NewLimiter(0, 16)
+	bm.SetUserLimiter("limited", bucket)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	ctx = session.ContextWithInbound(ctx, &session.Inbound{User: &protocol.MemoryUser{Email: "limited"}})
+	d := &DefaultDispatcher{policy: featurepolicy.DefaultManager{}, stats: featurestats.NoopManager{}, bandwidth: bm}
+	in, out := d.getLink(ctx)
+	for _, direction := range []struct {
+		src, dst *transport.Link
+		n        int32
+	}{{in, out, 7}, {out, in, 9}} {
+		if err := direction.src.Writer.WriteMultiBuffer(testPayload(direction.n)); err != nil {
+			t.Fatal(err)
+		}
+		mb, err := direction.dst.Reader.ReadMultiBuffer()
+		if mb.Len() != direction.n || err != nil {
+			t.Fatalf("pipe read: bytes=%d err=%v", mb.Len(), err)
+		}
+		buf.ReleaseMulti(mb)
+	}
+	if bucket.Tokens() != 0 {
+		t.Fatalf("after transferring exactly one burst, tokens=%v", bucket.Tokens())
+	}
+}
+
+func TestRateLimitWriterRespectsCanceledContext(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	w := &RateLimitWriter{
+		Writer:  &stubWriter{},
+		Limiter: rate.NewLimiter(1, 1),
+		Context: ctx,
+	}
+	b := buf.New()
+	b.Extend(2)
+	if err := w.WriteMultiBuffer(buf.MultiBuffer{b}); err == nil {
+		t.Fatal("expected canceled context to abort wait")
+	}
+}
