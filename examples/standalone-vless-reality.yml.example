# VLESS + Reality 独立节点（sing-box）。替换 UUID、私钥、short_id 和目标域名。
kernel:
  type: singbox
  config_dir: /var/lib/xboard-node/standalone-vless-reality
  log_level: warn
standalone:
  enabled: true
  node:
    protocol: vless
    listen_ip: "0.0.0.0"
    server_port: 443
    network: tcp
    tls: 2
    flow: xtls-rprx-vision
    tls_settings:
      private_key: "REPLACE_WITH_YOUR_REALITY_PRIVATE_KEY"
      short_id: "0123456789abcdef"
      # 将以下示例域名换成支持 TLS 1.3、可从服务器访问的实际 Reality 目标。
      server_name: "www.example.com"
      dest: "www.example.com:443"
  users:
    - id: 1
      uuid: "00000000-0000-4000-8000-000000000001"
log:
  level: info
  output: stdout
health_port: 0
