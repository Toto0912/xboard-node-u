# Xray VLESS + Reality 原生回落（v1.1.2）。替换 UUID、私钥、Short ID 和目标域名。
# dest 是 HTTPS 伪装目标；fallbacks 接收通过 Reality 握手后的解密数据，两者互不覆盖。
kernel:
  type: xray
  config_dir: /var/lib/xboard-node/standalone-xray-reality-fallback
  log_level: warn
standalone:
  enabled: true
  node:
    protocol: vless
    listen_ip: "0.0.0.0"
    server_port: 443
    network: tcp
    tls: 2
    flow: xtls-rprx-vision
    tls_settings:
      private_key: "REPLACE_WITH_YOUR_REALITY_PRIVATE_KEY"
      short_id: "0123456789abcdef"
      # 将以下示例域名换成支持 TLS 1.3、可从服务器访问的实际 Reality 目标。
      server_name: "www.example.com"
      dest: "www.example.com:443"  # HTTPS 原目标；“偷自己”可改为 127.0.0.1:8443
    fallbacks:                     # 协议层回落，通常填写明文 HTTP 后端
      - dest: "127.0.0.1:8080"
      - path: /special
        dest: "127.0.0.1:8081"
  users:
    - id: 1
      uuid: "00000000-0000-4000-8000-000000000001"
log:
  level: info
  output: stdout
health_port: 0
