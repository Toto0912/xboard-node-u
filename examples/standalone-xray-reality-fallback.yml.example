# Xray VLESS + Reality 单目标回落（v1.1.1 起）。替换 UUID、私钥、short_id 和 SNI。
# 先在 127.0.0.1:8443 运行支持 TLS 1.3、证书匹配 SNI 的 HTTPS 网站。
# 直接放入正在使用的主配置文件；不要与 fallbacks 多规则列表同时填写。
kernel:
  type: xray
  config_dir: /var/lib/xboard-node/standalone-xray-reality-fallback
  log_level: warn
standalone:
  enabled: true
  node:
    protocol: vless
    listen_ip: "0.0.0.0"
    server_port: 443
    network: tcp
    tls: 2
    flow: xtls-rprx-vision
    xray_fallback: "127.0.0.1:8443"
    tls_settings:
      private_key: "REPLACE_WITH_YOUR_REALITY_PRIVATE_KEY"
      short_id: "0123456789abcdef"
      # 保留网站对应的 SNI；有效 xray_fallback 只覆盖 dest，不改变此域名。
      server_name: "site.example.com"
      dest: "site.example.com:443"  # Xray 中被 xray_fallback 覆盖；sing-box 忽略新字段
  users:
    - id: 1
      uuid: "00000000-0000-4000-8000-000000000001"
log:
  level: info
  output: stdout
health_port: 0
