# SS 独立节点（sing-box）。将密码替换为自己的强密码。
kernel:
  type: singbox
  config_dir: /var/lib/xboard-node/standalone-ss
  log_level: warn
standalone:
  enabled: true
  node:
    protocol: shadowsocks
    listen_ip: "0.0.0.0"
    server_port: 8388
    cipher: chacha20-ietf-poly1305
  users:
    - id: 1
      # SS 的 uuid 字段用作密码，不要求 UUID 格式。
      uuid: "REPLACE_WITH_YOUR_SS_PASSWORD"
log:
  level: info
  output: stdout
health_port: 0
