# xboard-node-u v2.3.0 新增功能；旧版 v2.2.1 不支持自动范围转发。
# 提前准备匹配域名的证书，并替换示例 UUID。客户端间隔在客户端设置。
kernel:
  type: singbox # 也支持 xray
  config_dir: /etc/xboard-node/instances/standalone-hy2-port-hopping
  log_level: warn

cert:
  cert_mode: file
  cert_file: /etc/xboard-node/certs/example.crt
  key_file: /etc/xboard-node/certs/example.key

standalone:
  enabled: true
  node:
    protocol: hysteria
    version: 2
    listen_ip: "::"
    server_port: 60000
    server_name: "hy2.example.com"
    hy2_settings:
      bandwidth_mode: auto
      port_range: "60000-65000"
  users:
    - id: 1
      uuid: "00000000-0000-4000-8000-000000000001"

log:
  level: info
  output: stdout
health_port: 0
